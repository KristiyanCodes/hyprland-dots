{
    "display": {
        "separator": " ",
	"constants" : [
		"\u001b[102G│"
		],
	"bar": {
		"char": {
			"elapsed": "█",
			"total": "░"
		}
	},
	"key": {
		"width": 18
	}	
    },
    "logo": {
	"type": "kitty-icat",
	"source" : "$HOME/.config/fastfetch/3840px-Heckert_GNU_white.svg.png",
	"width" : 37

    },
    "general": {

    },
    "modules": [
	{ 
		"type" : "custom",
		"format": "╭──────────────┬─────────────────────────────────────────────╮"
	},
	{
        	"type" : "OS",
		"key" : "│ OS           │{$1}"
	},
	{
		"type" : "Kernel",
		"key" : "│ Kernel       │{$1}"
	},
	{
		"type" : "Packages",
		"key" : "│ Packages     │{$1}"
	},
	{
		"type" : "WM",
		"key" : "│ WM           │{$1}"
	},
	{
		"type" : "Theme",
		"key" : "│ Theme        │{$1}"
	},
	{
		"type" : "Icons",
		"key" : "│ Icons        │{$1}"
	},

	{
		"type" : "Cursor",
		"key" : "│ Cursor       │{$1}"
	},
	{
		"type" : "Terminal",
		"key" : "│ Terminal     │{$1}"
	},
	{
		"type" : "TerminalFont",
		"key" : "│ Terminal Font│{$1}"
	},
	{
		"type" : "Shell",
		"key" : "│ Shell        │{$1}"
	},
	{
		"type" : "custom",
		"format" : "├──────────────┼─────────────────────────────────────────────┤"
	},
	{
		"type" : "CPU",
		"key"  : "│ CPU          │{$1}",
		"format" : "{name} ({cores-physical}c {cores-logical}t) - {temperature}",
		"temp" : true
	},
	{
		"type" : "GPU",
		"key" : "│ GPU          │{$1}",
		"format" : "{vendor} {name} - [{type}]",
		"temp" : true,
		"driverSpecific" : true
	},
	{
		"type" : "GPU",
		"key" : "│ GPU info     │{$1}",
		"format" : "{core-count}c - {temperature} - ({dedicated-used} / {dedicated-total})",
		"temp" : true,
		"driverSpecific" : true

	},
	{
        	"type" : "Host",
		"key": "│ Host         │{$1}"
	},
	{
		"type" : "Monitor",
		"key" : "│ Monitor      │{$1}",
		"format" : "{width}x{height} @ {refresh-rate} HZ, {ppi} ppi ({name}) "
	},
	{
		"type" : "custom",
		"format": "├──────────────┼─────────────────────────────────────────────┤"
	},
	{
		"type": "CPUUsage",
		"key": "│ CPU Usage    │{$1}"
	},
        {
		"type" : "Memory",
		"key" : "│ Memory       │{$1}"
	},
	{
		"type" : "Uptime",
		"key" : "│ Uptime       │{$1}",
		"format" : "{formatted}"
	},
	{
        	"type" : "Battery",
		"key" : "│ Battery      │{$1}",
		"format" : "{capacity} [{status}] ({model-name})"
	},
	{
        	"type" : "Disk",
		"key" : "│ Disk         │{$1}",
		"format" : "({mountpoint}) {size-used} / {size-total} ({size-percentage}) - {filesystem}"
	},
	{
		"type" : "custom",
		"format" : "├──────────────┼─────────────────────────────────────────────┤"
        },
	{
		"type": "WiFi",
		"key" : "│ WiFi         │{$1}",
		"format": "{ssid}-{protocol}-{band}GHz {security} {signal-quality}"
	},
	{
		"type" : "LocalIp",
		"key" : "│ Local IP     │{$1}",
		"format" : "{ipv4} ({ifname})"
	},
	{
		"type" : "DNS",
		"key" : "│ DNS          │{$1}"
	},
	{
		"type" : "custom",
		"format" : "├──────────────┼─────────────────────────────────────────────┤"
	},
	{
		"type": "Player",
		"key" : "│ Media Player │{$1}"
	},
	{
		"type" : "Media",
		"key" : "│ Media        │{$1}",
		"format" : "{artist} - {title}"
	},
	{
		"type" : "Media",
		"key" : "│ Media pgr    │{$1}",
		"format" : "{progress} ({progress-num}) - [{status}]"
	},
	{
		"type" : "sound",
		"key" : "│ Sound        │{$1}",
		"format" : "{name} ({volume-percentage})"
	},
	{
		"type" : "custom",
		"format" : "├──────────────┼─────────────────────────────────────────────┤"
	},
	{
		"type" : "Users",
		"key" : "│ Users        │{$1}",
		"format" : "{name} - since {login-time}"
	},
	{
		"type" : "DateTime",
		"key" : "│ Date         │{$1}",
		"format" : "{weekday} {day-in-month} {month-name} {year}"
	},
	{
		"type" : "DateTime",
		"key" : "│ Time         │{$1}",
		"format" : "{hour}:{minute-pretty} ({hour-12-pretty}:{minute-pretty}{am-pm})"
	},
	{
		"type" : "Weather",
		"key" : "│ Weather      │{$1}"
	},
	{
		"type" : "custom",
		"format" : "╰──────────────┴─────────────────────────────────────────────╯"
	},
	{
		"type" : "custom",
		"format" : "               'dont use technology, own it'                "
	}
    ]
}
